[Unit]
Description=Mailroom API et synchronisation Resend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailroom
WorkingDirectory=/opt/mailroom
ExecStart=/usr/bin/node --env-file=/opt/mailroom/server/.env /opt/mailroom/server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
