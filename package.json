{
  "name": "mailroom",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "setup": "node scripts/setup.mjs",
    "server": "npm --prefix server start",
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix server test",
    "build": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "test:e2e": "playwright test",
    "server:start": "node scripts/service.mjs start api",
    "server:stop": "node scripts/service.mjs stop api",
    "server:status": "node scripts/service.mjs status api",
    "expo:start": "node scripts/service.mjs start expo",
    "expo:stop": "node scripts/service.mjs stop expo",
    "backup": "node scripts/backup.mjs",
    "tailscale:start": "node scripts/service.mjs start tailscale",
    "tailscale:stop": "node scripts/service.mjs stop tailscale",
    "lint": "expo lint"
  },
  "private": true
}
