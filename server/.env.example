# Configuration privée du serveur. Ne copie jamais ces valeurs dans le .env racine.
RESEND_API_KEY=<cle-api-resend>
APP_NAME=<nom-de-l-application>
APP_PASSWORD=<mot-de-passe-aleatoire-d-au-moins-16-caracteres>
ALLOWED_DOMAINS=<domaine-verifie-chez-resend>
HOST=127.0.0.1
PORT=3035
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3035,http://127.0.0.1:3035
