# Variables publiques utilisées par Expo. Ne mets jamais de secret ici.
# En local : http://localhost:3035
# Avec Tailscale : http://<IP_TAILSCALE_DU_SERVEUR>:3035
EXPO_PUBLIC_API_URL=<adresse-du-backend>

# Nom d'hôte ou IP Tailscale uniquement, sans http:// ni numéro de port.
# Exemple : 100.x.y.z
EXPO_PUBLIC_TAILSCALE_HOST=<hote-ou-ip-tailscale>

EXPO_PUBLIC_APP_NAME=<nom-de-l-application>
EXPO_PUBLIC_APP_TAGLINE=<slogan-de-l-application>
